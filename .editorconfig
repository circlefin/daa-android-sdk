root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# ktlint (official Kotlin code style). Keep the skeleton lint-clean.
ktlint_standard_no-wildcard-imports = enabled
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2
